<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bookora</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-amber-50 text-stone-800 flex flex-col">

    <%- include('includes/nav.ejs') %>

    <!-- Main Section -->
    <main class="flex-grow py-10 px-4">

        <div class="max-w-3xl mx-auto">

            <!-- Page Heading -->
            <div class="text-center mb-8">

                <span class="inline-block bg-amber-100 text-amber-900 px-4 py-2 rounded-full text-sm font-semibold mb-3">
                    ADMIN PANEL
                </span>

                <h1 class="text-3xl md:text-4xl font-bold text-stone-900">
                    Add New <span class="text-amber-700">Book</span>
                </h1>

                <p class="text-stone-500 mt-3">
                    Add a new book to your Bookora collection.
                </p>

            </div>

            <!-- Form Card -->
            <div class="bg-white rounded-2xl shadow-xl border border-amber-100 overflow-hidden">

                <!-- Card Header -->
                <div class="bg-stone-900 px-6 py-6">
                    <div class="flex items-center gap-4">

                        <div class="w-14 h-14 rounded-xl bg-amber-700 flex items-center justify-center text-3xl">
                            📚
                        </div>

                        <div>
                            <h2 class="text-xl font-bold text-amber-400">
                                Book Information
                            </h2>

                            <p class="text-stone-300 text-sm mt-1">
                                Fill in the details below
                            </p>
                        </div>

                    </div>
                </div>

                <!-- Add Book Form -->
                <form action="/books/new"
                      method="POST"
                      enctype="multipart/form-data"
                      class="p-6 md:p-8 space-y-6">

                    <!-- Book Title -->
                    <div>
                        <label for="title" class="block text-stone-700 font-semibold mb-2">
                            Book Title <span class="text-red-600">*</span>
                        </label>

                        <input
                            type="text"
                            id="title"
                            name="title"
                            placeholder="Enter book title"
                            required
                            class="w-full rounded-xl border border-stone-300 px-4 py-3 outline-none focus:border-amber-700 focus:ring-2 focus:ring-amber-100 transition"
                        >
                    </div>

                    <!-- Author and Price -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        <div>
                            <label for="authorName" class="block text-stone-700 font-semibold mb-2">
                                Author Name <span class="text-red-600">*</span>
                            </label>

                            <input
                                type="text"
                                id="authorName"
                                name="authorName"
                                placeholder="Enter author name"
                                required
                                class="w-full rounded-xl border border-stone-300 px-4 py-3 outline-none focus:border-amber-700 focus:ring-2 focus:ring-amber-100 transition"
                            >
                        </div>

                        <div>
                            <label for="price" class="block text-stone-700 font-semibold mb-2">
                                Price (₹) <span class="text-red-600">*</span>
                            </label>

                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-stone-500 font-semibold">
                                    ₹
                                </span>

                                <input
                                    type="number"
                                    id="price"
                                    name="price"
                                    placeholder="Enter price"
                                    min="0"
                                    step="0.01"
                                    required
                                    class="w-full rounded-xl border border-stone-300 pl-10 pr-4 py-3 outline-none focus:border-amber-700 focus:ring-2 focus:ring-amber-100 transition"
                                >
                            </div>
                        </div>

                    </div>

                    <!-- Category -->
                    <div>
                        <label for="category" class="block text-stone-700 font-semibold mb-2">
                            Book Category <span class="text-red-600">*</span>
                        </label>

                        <select
                            id="category"
                            name="category"
                            required
                            class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 outline-none focus:border-amber-700 focus:ring-2 focus:ring-amber-100 transition"
                        >
                            <option value="">Select a category</option>
                            <option value="Fantasy">Fantasy</option>
                            <option value="SelfLearning">Self Learning</option>
                            <option value="Fiction">Fiction</option>
                            <option value="Mystery">Mystery</option>
                            <option value="ScienceTechnology">Science & Technology</option>
                        </select>
                    </div>

                    <!-- Description -->
                    <div>
                        <label for="description" class="block text-stone-700 font-semibold mb-2">
                            Book Description
                        </label>

                        <textarea
                            id="description"
                            name="description"
                            rows="5"
                            placeholder="Write a short description about the book..."
                            class="w-full rounded-xl border border-stone-300 px-4 py-3 outline-none focus:border-amber-700 focus:ring-2 focus:ring-amber-100 transition resize-y"
                        ></textarea>
                    </div>

                    <!-- Book Image -->
                    <div>
                        <label for="img" class="block text-stone-700 font-semibold mb-2">
                            Book Cover Image
                        </label>

                        <div class="border-2 border-dashed border-amber-300 bg-amber-50 rounded-xl p-6 text-center hover:border-amber-600 transition">

                            <div class="text-4xl mb-3">🖼️</div>

                            <p class="text-stone-700 font-semibold mb-1">
                                Upload Book Cover
                            </p>

                            <p class="text-sm text-stone-500 mb-4">
                                Select an image from your device
                            </p>

                            <input
                                type="file"
                                id="img"
                                name="img"
                                accept="image/*"
                                class="block w-full text-sm text-stone-600
                                       file:mr-4 file:py-2 file:px-4
                                       file:rounded-lg file:border-0
                                       file:bg-amber-700 file:text-white
                                       file:font-semibold
                                       hover:file:bg-stone-900
                                       file:cursor-pointer cursor-pointer"
                            >

                            <p id="fileName" class="text-sm text-amber-800 mt-3"></p>

                            <img
                                id="imagePreview"
                                src=""
                                alt="Book cover preview"
                                class="hidden mx-auto mt-5 max-h-56 max-w-40 rounded-lg border border-amber-200 shadow-md object-contain bg-white"
                            >

                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="flex flex-col sm:flex-row gap-4 pt-2">

                        <button
                            type="submit"
                            class="flex-1 bg-amber-700 hover:bg-stone-900 text-white font-semibold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transition duration-300"
                        >
                            + Add Book
                        </button>

                        <a
                            href="/books"
                            class="flex-1 text-center bg-stone-100 hover:bg-stone-200 text-stone-800 font-semibold py-3 px-6 rounded-xl border border-stone-200 transition duration-300"
                        >
                            Cancel
                        </a>

                    </div>

                    <p class="text-xs text-stone-400">
                        * Required fields
                    </p>

                </form>

            </div>

            <p class="text-center text-stone-400 text-sm mt-6">
                Bookora · Admin Management
            </p>

        </div>

    </main>

    <%- include('includes/footer.ejs') %>

    <!-- Image Preview -->
    <script>
        const imageInput = document.getElementById('img');
        const imagePreview = document.getElementById('imagePreview');
        const fileName = document.getElementById('fileName');

        let previewUrl = '';

        imageInput.addEventListener('change', function () {
            const file = this.files[0];

            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
                previewUrl = '';
            }

            if (!file) {
                imagePreview.classList.add('hidden');
                imagePreview.removeAttribute('src');
                fileName.textContent = '';
                return;
            }

            if (!file.type.startsWith('image/')) {
                alert('Please select a valid image file.');
                this.value = '';
                imagePreview.classList.add('hidden');
                fileName.textContent = '';
                return;
            }

            previewUrl = URL.createObjectURL(file);
            imagePreview.src = previewUrl;
            imagePreview.classList.remove('hidden');
            fileName.textContent = 'Selected: ' + file.name;
        });
    </script>

</body>
</html>
