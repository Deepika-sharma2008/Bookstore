
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bookora</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-amber-50 text-stone-800 flex flex-col">

    <%- include('includes/nav.ejs') %>

    <!-- Main Section -->
    <main class="flex-grow py-10 px-4">

        <div class="max-w-3xl mx-auto">

            <!-- Heading -->
            <div class="text-center mb-8">

                <span class="inline-block bg-amber-100 text-amber-900 px-4 py-2 rounded-full text-sm font-semibold mb-3">
                    ADMIN PANEL
                </span>

                <h1 class="text-3xl md:text-4xl font-bold text-stone-900">
                    Update <span class="text-amber-700">Book</span>
                </h1>

                <p class="text-stone-500 mt-3">
                    Edit the book details and save your changes.
                </p>

            </div>

            <!-- Form Card -->
            <div class="bg-white rounded-2xl shadow-xl border border-amber-100 overflow-hidden">

                <!-- Card Header -->
                <div class="bg-stone-900 px-6 py-5">
                    <h2 class="text-xl font-bold text-amber-400">
                        Book Information
                    </h2>

                    <p class="text-stone-300 text-sm mt-1">
                        Update the information below
                    </p>
                </div>

                <!-- Update Form -->
                <form action="/books/<%= book._id %>/edit"
                      method="POST"
                      class="p-6 md:p-8 space-y-6">

                    <!-- Book Title -->
                    <div>
                        <label for="title" class="block text-stone-700 font-semibold mb-2">
                            Book Title *
                        </label>

                        <input
                            type="text"
                            id="title"
                            name="title"
                            value="<%= book.title %>"
                            placeholder="Enter book title"
                            required
                            class="w-full rounded-xl border border-stone-300 px-4 py-3 outline-none focus:border-amber-700 focus:ring-2 focus:ring-amber-100 transition"
                        >
                    </div>

                    <!-- Author and Category -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        <div>
                            <label for="authorName" class="block text-stone-700 font-semibold mb-2">
                                Author Name *
                            </label>

                            <input
                                type="text"
                                id="authorName"
                                name="authorName"
                                value="<%= book.authorName %>"
                                placeholder="Enter author name"
                                required
                                class="w-full rounded-xl border border-stone-300 px-4 py-3 outline-none focus:border-amber-700 focus:ring-2 focus:ring-amber-100 transition"
                            >
                        </div>

                        <div>
                            <label for="category" class="block text-stone-700 font-semibold mb-2">
                                Category *
                            </label>

                            <input
                                type="text"
                                id="category"
                                name="category"
                                value="<%= book.category || '' %>"
                                placeholder="e.g. Fantasy"
                                required
                                class="w-full rounded-xl border border-stone-300 px-4 py-3 outline-none focus:border-amber-700 focus:ring-2 focus:ring-amber-100 transition"
                            >
                        </div>

                    </div>

                    <!-- Price -->
                    <div>
                        <label for="price" class="block text-stone-700 font-semibold mb-2">
                            Price (₹) *
                        </label>

                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-stone-500 font-semibold">
                                ₹
                            </span>

                            <input
                                type="number"
                                id="price"
                                name="price"
                                value="<%= book.price %>"
                                min="0"
                                step="0.01"
                                placeholder="Enter book price"
                                required
                                class="w-full rounded-xl border border-stone-300 pl-10 pr-4 py-3 outline-none focus:border-amber-700 focus:ring-2 focus:ring-amber-100 transition"
                            >
                        </div>
                    </div>

                    <!-- Description -->
                    <div>
                        <label for="description" class="block text-stone-700 font-semibold mb-2">
                            Description
                        </label>

                        <textarea
                            id="description"
                            name="description"
                            rows="5"
                            placeholder="Write a short description about this book..."
                            class="w-full rounded-xl border border-stone-300 px-4 py-3 outline-none focus:border-amber-700 focus:ring-2 focus:ring-amber-100 transition resize-y"
                        ><%= book.description || '' %></textarea>
                    </div>

                    <!-- Current Image -->
                    <div class="border border-amber-200 bg-amber-50 rounded-xl p-5">

                        <h3 class="text-stone-800 font-semibold mb-3">
                            Current Book Image
                        </h3>

                        <% if (book.image) { %>

                            <img
                                src="<%= book.image %>"
                                alt="<%= book.title %>"
                                class="w-36 h-48 object-contain bg-white rounded-lg shadow-md border border-stone-200"
                            >

                            <p class="text-sm text-stone-500 mt-3">
                                Your existing book image will be kept.
                            </p>

                        <% } else { %>

                            <div class="w-36 h-40 rounded-lg bg-white border border-dashed border-amber-400 flex items-center justify-center text-center p-3">
                                <span class="text-sm text-stone-500">
                                    No image available
                                </span>
                            </div>

                        <% } %>

                    </div>

                    <!-- Buttons -->
                    <div class="flex flex-col sm:flex-row gap-4 pt-2">

                        <button
                            type="submit"
                            class="flex-1 bg-amber-700 hover:bg-stone-900 text-white font-semibold py-3 px-6 rounded-xl shadow-md transition duration-300"
                        >
                            Save Changes
                        </button>

                        <a
                            href="/books"
                            class="flex-1 text-center bg-stone-100 hover:bg-stone-200 text-stone-800 font-semibold py-3 px-6 rounded-xl border border-stone-200 transition duration-300"
                        >
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

            <p class="text-center text-stone-400 text-sm mt-6">
                Bookora · Admin Management
            </p>

        </div>

    </main>

    <%- include('includes/footer.ejs') %>

</body>
</html>
